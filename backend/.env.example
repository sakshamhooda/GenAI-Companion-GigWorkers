# Copy to backend/.env for local dev. Never commit backend/.env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
# Token signing secret: openssl rand -hex 32
SECRET_KEY=change-me
# Gemini (https://aistudio.google.com/apikey). App runs in stub mode without it.
GEMINI_API_KEY=
# Sarvam AI speech (https://dashboard.sarvam.ai). Optional; falls back to Gemini audio.
SARVAM_API_KEY=
